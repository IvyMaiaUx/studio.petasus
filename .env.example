# --- Obrigatórias ---
# String de conexão do Postgres do Supabase (use a do "pooler", porta 6543 ou 5432)
DATABASE_URI=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Texto longo e aleatório (ex.: gere com: openssl rand -hex 32). Nunca compartilhe.
PAYLOAD_SECRET=
# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://studio.seudominio.com

# --- Imagens no Supabase Storage (S3) ---
# Supabase > Storage > S3 Connection: endpoint, região e chaves de acesso
S3_ENDPOINT=https://SEU_PROJETO.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
